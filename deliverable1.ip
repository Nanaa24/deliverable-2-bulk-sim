        "import pandas as pd\n",
        "import random\n",
        "\n",
        "# Create lists of sample sentences (restaurant reviews as an example)\n",
        "food_comments = [\n",
        "    \"The pasta was cooked to perfection\",\n",
        "    \"Steak was overcooked and tough\",\n",
        "    \"Fresh sushi with amazing presentation\",\n",
        "    \"Pizza had too much cheese\",\n",
        "    \"The soup was lukewarm at best\",\n",
        "    \"Best burger I've ever tasted\",\n",
        "    \"The salad ingredients were very fresh\",\n",
        "    \"Dessert was too sweet for my taste\",\n",
        "    \"Perfect balance of flavors in the curry\",\n",
        "    \"The chicken was a bit dry\"\n",
        "]\n",
        "\n",
        "service_comments = [\n",
        "    \"Waiter was very attentive and friendly\",\n",
        "    \"Had to wait 45 minutes for our food\",\n",
        "    \"Service was quick and professional\",\n",
        "    \"The staff seemed uninterested\",\n",
        "    \"Our server went above and beyond\",\n",
        "    \"Restaurant was understaffed\",\n",
        "    \"Great recommendations from the staff\",\n",
        "    \"Slow service during peak hours\",\n",
        "    \"Very accommodating with our requests\",\n",
        "    \"The manager was rude to customers\"\n",
        "]\n",
        "\n",
        "# Create random ratings (1-5 stars)\n",
        "ratings = [random.randint(1, 5) for _ in range(len(food_comments))]\n",
        "\n",
        "# Create a dictionary with the data\n",
        "data = {\n",
        "    'Food_Review': food_comments,\n",
        "    'Service_Review': service_comments,\n",
        "    'Rating_Stars': ratings\n",
        "}\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Export to CSV\n",
        "df.to_csv('restaurant_reviews.csv', index=False)\n",
        "\n",
        "# Print the DataFrame\n",
        "print(\"\\nRestaurant Reviews Dataset:\")\n",
        "print(df)\n",
        "\n",
        "# Print some basic statistics\n",
        "print(\"\\nRating Statistics:\")\n",
        "print(df['Rating_Stars'].describe())\n",
        "\n",
        "# Print rating distribution\n",
        "print(\"\\nRating Distribution:\")\n",
        "print(df['Rating_Stars'].value_counts().sort_index())"
      ],

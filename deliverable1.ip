    {
      "cell_type": "code",
      "source": [
        " import pandas as pd\n",
        "import numpy as np\n",
        "import random\n",
        "\n",
        "# Create lists of sample sentences\n",
        "sentences1 = [\n",
        "    \"The quick brown fox jumps over the lazy dog\",\n",
        "    \"A beautiful sunset painted the sky in vibrant colors\",\n",
        "    \"She walked through the garden admiring the flowers\",\n",
        "    \"The old library was filled with dusty books\",\n",
        "    \"Children played happily in the park\",\n",
        "    \"The coffee shop was busy on Monday morning\",\n",
        "    \"Waves crashed against the rocky shore\",\n",
        "    \"The mountain peak was covered in snow\",\n",
        "    \"A gentle breeze rustled through the trees\",\n",
        "    \"The city lights sparkled in the distance\"\n",
        "]\n",
        "\n",
        "sentences2 = [\n",
        "    \"The dog watched the fox with curiosity\",\n",
        "    \"People gathered to watch the evening sky\",\n",
        "    \"The butterflies danced among the petals\",\n",
        "    \"Students studied quietly at their desks\",\n",
        "    \"Parents watched from nearby benches\",\n",
        "    \"The barista prepared drinks with expertise\",\n",
        "    \"Seabirds soared above the water\",\n",
        "    \"Hikers made their way to the summit\",\n",
        "    \"Leaves scattered across the ground\",\n",
        "    \"Cars honked in the evening traffic\"\n",
        "]\n",
        "\n",
        "# Create a dictionary with the data\n",
        "data = {\n",
        "    'Text_Column_1': sentences1,\n",
        "    'Text_Column_2': sentences2,\n",
        "    'Score': [random.randint(60, 100) for _ in range(len(sentences1))]  # Random scores between 60 and 100\n",
        "}\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Export to CSV\n",
        "df.to_csv('simulated_data.csv', index=False)\n",
        "\n",
        "# Display the first few rows of the DataFrame\n",
        "print(df.head())"
      ],
      "metadata": {

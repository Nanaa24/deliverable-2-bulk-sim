        "import re\n",
        "\n",
        "def assess_content_quality(text):\n",
        "    \"\"\"\n",
        "    Assess the quality of content based on various criteria\n",
        "    Returns a score out of 100\n",
        "    \"\"\"\n",
        "    score = 0\n",
        "    details = {}  # To store detailed scoring breakdown\n",
        "\n",
        "    # 1. Check for citations/references (max 20 points)\n",
        "    citation_patterns = [\n",
        "        r'\\([^)]*\\d{4}[^)]*\\)',  # (Author, 2023) or (2023)\n",
        "        r'et al',\n",
        "        r'http[s]?://(?:[a-zA-Z]|[0-9]|[$-_@.&+]|[!*\\\\(\\\\),]|(?:%[0-9a-fA-F][0-9a-fA-F]))+',  # URLs\n",
        "        r'doi:[\\w/.]+',  # DOI references\n",
        "    ]\n",
        "\n",
        "    citation_count = sum(1 for pattern in citation_patterns if re.search(pattern, text))\n",
        "    citation_score = min(citation_count * 5, 20)\n",
        "    score += citation_score\n",
        "    details['citation_score'] = citation_score\n",
        "\n",
        "    # 2. Check for evidence/data points (max 20 points)\n",
        "    evidence_patterns = [\n",
        "        r'\\d+%',  # Percentages\n",
        "        r'\\d+\\.?\\d*\\s*(?:million|billion|thousand)',  # Large numbers\n",
        "        r'\\$\\s*\\d+(?:,\\d{3})*(?:\\.\\d{2})?',  # Money amounts\n",
        "        r'\\d+\\s*(?:participants|subjects|people|students)',  # Study sizes\n",
        "    ]\n",
        "\n",
        "    evidence_count = sum(1 for pattern in evidence_patterns if re.search(pattern, text))\n",
        "    evidence_score = min(evidence_count * 5, 20)\n",
        "    score += evidence_score\n",
        "    details['evidence_score'] = evidence_score\n",
        "\n",
        "    # 3. Technical terminology (max 20 points)\n",
        "    technical_terms = [\n",
        "        'analysis', 'study', 'research', 'methodology', 'data',\n",
        "        'significant', 'hypothesis', 'experiment', 'theory', 'framework',\n",
        "        'implementation', 'algorithm', 'statistical', 'correlation', 'variable'\n",
        "    ]\n",
        "\n",
        "    term_count = sum(1 for term in technical_terms if term.lower() in text.lower())\n",
        "    technical_score = min(term_count * 4, 20)\n",
        "    score += technical_score\n",
        "    details['technical_score'] = technical_score\n",
        "\n",
        "    # 4. Length and depth (max 20 points)\n",
        "    words = text.split()\n",
        "    word_count = len(words)\n",
        "\n",
        "    if word_count >= 200:\n",
        "        length_score = 20\n",
        "    elif word_count >= 150:\n",
        "        length_score = 15\n",
        "    elif word_count >= 100:\n",
        "        length_score = 10\n",
        "    elif word_count >= 50:\n",
        "        length_score = 5\n",
        "    else:\n",
        "        length_score = 0\n",
        "\n",
        "    score += length_score\n",
        "    details['length_score'] = length_score\n",
        "\n",
        "    # 5. Multiple sources (max 20 points)\n",
        "    # Count unique citations\n",
        "    citations = re.findall(r'\\([^)]*\\d{4}[^)]*\\)', text)\n",
        "    unique_citations = len(set(citations))\n",
        "\n",
        "    source_score = min(unique_citations * 5, 20)\n",
        "    score += source_score\n",
        "    details['source_score'] = source_score\n",
        "\n",
        "    return {\n",
        "        'total_score': score,\n",
        "        'details': details,\n",
        "        'feedback': generate_feedback(details)\n",
        "    }\n",
        "\n",
        "def generate_feedback(details):\n",
        "    \"\"\"Generate feedback based on scoring details\"\"\"\n",
        "    feedback = []\n",
        "\n",
        "    if details['citation_score'] < 10:\n",
        "        feedback.append(\"Consider adding more citations to support your points.\")\n",
        "    if details['evidence_score'] < 10:\n",
        "        feedback.append(\"Include more specific data points or evidence.\")\n",
        "    if details['technical_score'] < 10:\n",
        "        feedback.append(\"Try incorporating more technical terminology.\")\n",
        "    if details['length_score'] < 10:\n",
        "        feedback.append(\"The response could be more detailed.\")\n",
        "    if details['source_score'] < 10:\n",
        "        feedback.append(\"Try citing multiple sources to strengthen your argument.\")\n",
        "\n",
        "    return feedback\n",
        "\n",
        "# Example usage:\n",
        "example_text = \"\"\"\n",
        "According to Smith (2023), 85% of participants showed improved results.\n",
        "The study involved 500 students at major universities.\n",
        "Furthermore, Johnson et al. (2022) demonstrated a significant correlation\n",
        "between variables (p < 0.05). The methodology implemented followed standard\n",
        "statistical analysis procedures (Brown, 2021).\n",
        "Source: https://example.edu/research\n",
        "\"\"\"\n",
        "\n",
        "result = assess_content_quality(example_text)\n",
        "print(f\"Total Score: {result['total_score']}/100\")\n",
        "print(\"\\nDetailed Scores:\")\n",
        "for category, score in result['details'].items():\n",
        "    print(f\"{category}: {score}\")\n",
        "print(\"\\nFeedback:\")\n",
        "for feedback in result['feedback']:\n",
        "    print(f\"- {feedback}\")"
      ],
